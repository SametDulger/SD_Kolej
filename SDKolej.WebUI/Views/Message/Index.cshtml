@model IEnumerable<SDKolej.Business.DTOs.MessageDto>

@{
    ViewData["Title"] = "Mesaj Listesi";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Mesajlar</h3>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Yeni Mesaj
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Gönderen</th>
                                    <th>Alıcı</th>
                                    <th>Konu</th>
                                    <th>İçerik</th>
                                    <th>Gönderilme Tarihi</th>
                                    <th>Durum</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @{
                                                var senderName = "";
                                                if (item.SenderStudent != null)
                                                    senderName = $"{item.SenderStudent.FirstName} {item.SenderStudent.LastName} (Öğrenci)";
                                                else if (item.SenderTeacher != null)
                                                    senderName = $"{item.SenderTeacher.FirstName} {item.SenderTeacher.LastName} (Öğretmen)";
                                                else if (item.SenderParent != null)
                                                    senderName = $"{item.SenderParent.FirstName} {item.SenderParent.LastName} (Veli)";
                                                else
                                                    senderName = "Belirtilmemiş";
                                            }
                                            @senderName
                                        </td>
                                        <td>
                                            @{
                                                var receiverName = "";
                                                if (item.ReceiverStudent != null)
                                                    receiverName = $"{item.ReceiverStudent.FirstName} {item.ReceiverStudent.LastName} (Öğrenci)";
                                                else if (item.ReceiverTeacher != null)
                                                    receiverName = $"{item.ReceiverTeacher.FirstName} {item.ReceiverTeacher.LastName} (Öğretmen)";
                                                else if (item.ReceiverParent != null)
                                                    receiverName = $"{item.ReceiverParent.FirstName} {item.ReceiverParent.LastName} (Veli)";
                                                else
                                                    receiverName = "Belirtilmemiş";
                                            }
                                            @receiverName
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.Subject)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Content)</td>
                                        <td>@Html.DisplayFor(modelItem => item.SentDate)</td>
                                        <td>
                                            @if (item.IsRead)
                                            {
                                                <span class="badge bg-success">Okundu</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Okunmadı</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 