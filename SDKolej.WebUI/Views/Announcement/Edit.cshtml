@model SDKolej.Business.DTOs.AnnouncementDto
@{
    ViewData["Title"] = "Duyuru Düzenle";
}
<h2>Duyuru Düzenle</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="TeacherId" class="form-label">Öğretmen</label>
        <select asp-for="TeacherId" class="form-control" asp-items="ViewBag.Teachers">
            <option value="">Öğretmen Seçiniz</option>
        </select>
        <span asp-validation-for="TeacherId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ClassId" class="form-label">Sınıf</label>
        <select asp-for="ClassId" class="form-control" asp-items="ViewBag.Classes">
            <option value="">Sınıf Seçiniz</option>
        </select>
        <span asp-validation-for="ClassId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" class="form-control" rows="5"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form> 