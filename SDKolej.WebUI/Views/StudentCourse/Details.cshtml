@model SDKolej.Business.DTOs.StudentCourseDto

@{
    ViewData["Title"] = "Öğrenci Dersi Detayları";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-eye me-2"></i>
                        Öğrenci Dersi Detayları
                    </h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Öğrenci:</dt>
                        <dd class="col-sm-9">@(Model.Student?.FirstName) @(Model.Student?.LastName) - @(Model.Student?.SchoolNumber)</dd>

                        <dt class="col-sm-3">Ders:</dt>
                        <dd class="col-sm-9">@Model.Course?.Name</dd>

                        <dt class="col-sm-3">Sınıf:</dt>
                        <dd class="col-sm-9">@(Model.Class?.Name) - @(Model.Class?.Branch?.Name)</dd>

                        <dt class="col-sm-3">Öğretmen:</dt>
                        <dd class="col-sm-9">@(Model.Teacher?.FirstName) @(Model.Teacher?.LastName)</dd>

                        <dt class="col-sm-3">Akademik Yıl:</dt>
                        <dd class="col-sm-9">@Model.AcademicYear</dd>

                        <dt class="col-sm-3">Durum:</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Pasif</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Kayıt Tarihi:</dt>
                        <dd class="col-sm-9">@Model.EnrollmentDate.ToString("dd/MM/yyyy")</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i>
                        Düzenle
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>
                        Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div> 